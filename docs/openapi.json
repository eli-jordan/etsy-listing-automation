{
  "components": {
    "schemas": {
      "Body_upload_template_api_templates_post": {
        "properties": {
          "files": {
            "items": {
              "contentMediaType": "application/octet-stream",
              "type": "string"
            },
            "title": "Files",
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "title": "Body_upload_template_api_templates_post",
        "type": "object"
      },
      "DisplaceConfig": {
        "description": "PRD: implemented but off by default -- over-strong displacement looks\nmelted, so it's tuned per template in the calibrator's live preview.",
        "properties": {
          "enabled": {
            "default": false,
            "title": "Enabled",
            "type": "boolean"
          },
          "strength": {
            "default": 0.0,
            "title": "Strength",
            "type": "number"
          }
        },
        "title": "DisplaceConfig",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PreviewRequest": {
        "properties": {
          "colour": {
            "title": "Colour",
            "type": "string"
          },
          "design": {
            "const": "bundled-grid",
            "default": "bundled-grid",
            "title": "Design",
            "type": "string"
          },
          "displace": {
            "$ref": "#/components/schemas/DisplaceConfig",
            "default": {
              "enabled": false,
              "strength": 0.0
            }
          },
          "shade": {
            "$ref": "#/components/schemas/ShadeConfig",
            "default": {
              "blend": "soft-light",
              "enabled": true,
              "opacity": 0.6
            }
          },
          "warp": {
            "$ref": "#/components/schemas/WarpConfig"
          }
        },
        "required": [
          "colour",
          "warp"
        ],
        "title": "PreviewRequest",
        "type": "object"
      },
      "ShadeConfig": {
        "description": "PRD: on by default. ``multiply`` crushes prints on dark garments, so\n``soft-light`` or a mid-grey pivot is used for those instead.",
        "properties": {
          "blend": {
            "default": "soft-light",
            "enum": [
              "multiply",
              "soft-light",
              "grey-pivot"
            ],
            "title": "Blend",
            "type": "string"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "opacity": {
            "default": 0.6,
            "title": "Opacity",
            "type": "number"
          }
        },
        "title": "ShadeConfig",
        "type": "object"
      },
      "TemplateConfigResponse": {
        "properties": {
          "displace": {
            "$ref": "#/components/schemas/DisplaceConfig"
          },
          "shade": {
            "$ref": "#/components/schemas/ShadeConfig"
          },
          "warp": {
            "$ref": "#/components/schemas/WarpConfig"
          }
        },
        "required": [
          "warp",
          "displace",
          "shade"
        ],
        "title": "TemplateConfigResponse",
        "type": "object"
      },
      "TemplateConfigUpdate": {
        "properties": {
          "displace": {
            "$ref": "#/components/schemas/DisplaceConfig",
            "default": {
              "enabled": false,
              "strength": 0.0
            }
          },
          "shade": {
            "$ref": "#/components/schemas/ShadeConfig",
            "default": {
              "blend": "soft-light",
              "enabled": true,
              "opacity": 0.6
            }
          },
          "warp": {
            "$ref": "#/components/schemas/WarpConfig"
          }
        },
        "required": [
          "warp"
        ],
        "title": "TemplateConfigUpdate",
        "type": "object"
      },
      "TemplateSummary": {
        "properties": {
          "colours": {
            "items": {
              "type": "string"
            },
            "title": "Colours",
            "type": "array"
          },
          "has_config": {
            "title": "Has Config",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "colours",
          "has_config"
        ],
        "title": "TemplateSummary",
        "type": "object"
      },
      "UploadResponse": {
        "properties": {
          "colours": {
            "items": {
              "type": "string"
            },
            "title": "Colours",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "colours"
        ],
        "title": "UploadResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WarpConfig": {
        "properties": {
          "quad": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              }
            ],
            "title": "Quad",
            "type": "array"
          }
        },
        "required": [
          "quad"
        ],
        "title": "WarpConfig",
        "type": "object"
      }
    }
