{
  "components": {
    "schemas": {
      "Body_upload_template_api_templates_post": {
        "properties": {
          "files": {
            "items": {
              "contentMediaType": "application/octet-stream",
              "type": "string"
            },
            "title": "Files",
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "title": "Body_upload_template_api_templates_post",
        "type": "object"
      },
      "ColourMatrixPreviewRequest": {
        "description": "Disambiguated from the other two preview shapes by required fields\nalone (``colour`` here, ``placements`` on ``MultiplePreviewRequest``,\nneither on ``SinglePreviewRequest``) -- extra fields are ignored rather\nthan forbidden, since a natural client pattern is spreading a whole\n``GET .../config`` response (which includes ``kind``) into the body.",
        "properties": {
          "bounding_box": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "$ref": "#/components/schemas/Point"
              }
            ],
            "title": "Bounding Box",
            "type": "array"
          },
          "colour": {
            "title": "Colour",
            "type": "string"
          },
          "design": {
            "default": "bundled-grid",
            "enum": [
              "bundled-grid",
              "bundled-on-light",
              "bundled-on-dark"
            ],
            "title": "Design",
            "type": "string"
          },
          "displace": {
            "$ref": "#/components/schemas/DisplaceConfig",
            "default": {
              "enabled": false,
              "strength": 0.0
            }
          },
          "shade": {
            "$ref": "#/components/schemas/ShadeConfig",
            "default": {
              "blend": "soft-light",
              "enabled": true,
              "opacity": 0.6
            }
          }
        },
        "required": [
          "colour",
          "bounding_box"
        ],
        "title": "ColourMatrixPreviewRequest",
        "type": "object"
      },
      "ColourMatrixTemplate": {
        "description": "One photo per colour, same design position in all of them. Scene\nimages are ``{colour-slug}.png`` per colour (PRD 7a) -- there is no\n``colours:`` list in the YAML, since the filenames present in the\ndirectory *are* the colour set.",
        "properties": {
          "bounding_box": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "$ref": "#/components/schemas/Point"
              }
            ],
            "title": "Bounding Box",
            "type": "array"
          },
          "displace": {
            "$ref": "#/components/schemas/DisplaceConfig",
            "default": {
              "enabled": false,
              "strength": 0.0
            }
          },
          "kind": {
            "const": "colour-matrix",
            "default": "colour-matrix",
            "title": "Kind",
            "type": "string"
          },
          "shade": {
            "$ref": "#/components/schemas/ShadeConfig",
            "default": {
              "blend": "soft-light",
              "enabled": true,
              "opacity": 0.6
            }
          }
        },
        "required": [
          "bounding_box"
        ],
        "title": "ColourMatrixTemplate",
        "type": "object"
      },
      "DisplaceConfig": {
        "description": "PRD: implemented but off by default -- over-strong displacement looks\nmelted, so it's tuned per template in the calibrator's live preview.",
        "properties": {
          "enabled": {
            "default": false,
            "title": "Enabled",
            "type": "boolean"
          },
          "strength": {
            "default": 0.0,
            "title": "Strength",
            "type": "number"
          }
        },
        "title": "DisplaceConfig",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MultiplePreviewRequest": {
        "properties": {
          "design": {
            "default": "bundled-grid",
            "enum": [
              "bundled-grid",
              "bundled-on-light",
              "bundled-on-dark"
            ],
            "title": "Design",
            "type": "string"
          },
          "displace": {
            "$ref": "#/components/schemas/DisplaceConfig",
            "default": {
              "enabled": false,
              "strength": 0.0
            }
          },
          "placements": {
            "items": {
              "$ref": "#/components/schemas/Placement"
            },
            "title": "Placements",
            "type": "array"
          },
          "shade": {
            "$ref": "#/components/schemas/ShadeConfig",
            "default": {
              "blend": "soft-light",
              "enabled": true,
              "opacity": 0.6
            }
          }
        },
        "required": [
          "placements"
        ],
        "title": "MultiplePreviewRequest",
        "type": "object"
      },
      "MultipleTemplate": {
        "description": "Several garments in one photo. ``displace``/``shade`` are scene-level\nonly -- one photo, one lighting pass; a placement needing different\nrendering treatment belongs in its own template instead.",
        "properties": {
          "colour_coverage": {
            "default": "exact",
            "enum": [
              "exact",
              "subset"
            ],
            "title": "Colour Coverage",
            "type": "string"
          },
          "displace": {
            "$ref": "#/components/schemas/DisplaceConfig",
            "default": {
              "enabled": false,
              "strength": 0.0
            }
          },
          "kind": {
            "const": "multiple",
            "default": "multiple",
            "title": "Kind",
            "type": "string"
          },
          "placements": {
            "items": {
              "$ref": "#/components/schemas/Placement"
            },
            "title": "Placements",
            "type": "array"
          },
          "shade": {
            "$ref": "#/components/schemas/ShadeConfig",
            "default": {
              "blend": "soft-light",
              "enabled": true,
              "opacity": 0.6
            }
          }
        },
        "required": [
          "placements"
        ],
        "title": "MultipleTemplate",
        "type": "object"
      },
      "Placement": {
        "description": "One garment within a ``multiple``-kind scene.",
        "properties": {
          "artwork": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artwork"
          },
          "bounding_box": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "$ref": "#/components/schemas/Point"
              }
            ],
            "title": "Bounding Box",
            "type": "array"
          },
          "colour": {
            "title": "Colour",
            "type": "string"
          }
        },
        "required": [
          "colour",
          "bounding_box"
        ],
        "title": "Placement",
        "type": "object"
      },
      "Point": {
        "properties": {
          "x": {
            "title": "X",
            "type": "number"
          },
          "y": {
            "title": "Y",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "title": "Point",
        "type": "object"
      },
      "ShadeConfig": {
        "description": "Blends the base mockup photo's own greyscale lighting over the printed\ndesign, so a flat design picks up the garment's real fold shadows and\nlight falloff instead of looking pasted on as a flat rectangle -- this is\nwhy a plain flat-lay PNG is enough to mock up, with no purchased\nPhotoshop lighting map needed. On by default: almost every mockup needs\nit. ``multiply`` crushes prints on dark garments, so ``soft-light`` or a\nmid-grey pivot is used for those instead.",
        "properties": {
          "blend": {
            "default": "soft-light",
            "enum": [
              "multiply",
              "soft-light",
              "grey-pivot"
            ],
            "title": "Blend",
            "type": "string"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "opacity": {
            "default": 0.6,
            "title": "Opacity",
            "type": "number"
          }
        },
        "title": "ShadeConfig",
        "type": "object"
      },
      "SinglePreviewRequest": {
        "properties": {
          "bounding_box": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "$ref": "#/components/schemas/Point"
              }
            ],
            "title": "Bounding Box",
            "type": "array"
          },
          "design": {
            "default": "bundled-grid",
            "enum": [
              "bundled-grid",
              "bundled-on-light",
              "bundled-on-dark"
            ],
            "title": "Design",
            "type": "string"
          },
          "displace": {
            "$ref": "#/components/schemas/DisplaceConfig",
            "default": {
              "enabled": false,
              "strength": 0.0
            }
          },
          "shade": {
            "$ref": "#/components/schemas/ShadeConfig",
            "default": {
              "blend": "soft-light",
              "enabled": true,
              "opacity": 0.6
            }
          }
        },
        "required": [
          "bounding_box"
        ],
        "title": "SinglePreviewRequest",
        "type": "object"
      },
      "SingleTemplate": {
        "description": "One photo, one garment -- a lifestyle shot, a folded product photo,\nanything that isn't part of a colour set.",
        "properties": {
          "artwork": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artwork"
          },
          "bounding_box": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "$ref": "#/components/schemas/Point"
              }
            ],
            "title": "Bounding Box",
            "type": "array"
          },
          "colour": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Colour"
          },
          "displace": {
            "$ref": "#/components/schemas/DisplaceConfig",
            "default": {
              "enabled": false,
              "strength": 0.0
            }
          },
          "kind": {
            "const": "single",
            "default": "single",
            "title": "Kind",
            "type": "string"
          },
          "shade": {
            "$ref": "#/components/schemas/ShadeConfig",
            "default": {
              "blend": "soft-light",
              "enabled": true,
              "opacity": 0.6
            }
          }
        },
        "required": [
          "bounding_box"
        ],
        "title": "SingleTemplate",
        "type": "object"
      },
      "TemplateSummary": {
        "properties": {
          "colours": {
            "items": {
              "type": "string"
            },
            "title": "Colours",
            "type": "array"
          },
          "has_config": {
            "title": "Has Config",
            "type": "boolean"
          },
          "kind": {
            "anyOf": [
              {
                "enum": [
                  "colour-matrix",
                  "multiple",
                  "single"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kind"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "colours",
          "has_config"
        ],
        "title": "TemplateSummary",
        "type": "object"
      },
      "UploadResponse": {
        "properties": {
          "colours": {
            "items": {
              "type": "string"
            },
            "title": "Colours",
            "type": "array"
          },
          "kind": {
            "enum": [
              "colour-matrix",
              "multiple",
              "single"
            ],
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "colours"
        ],
        "title": "UploadResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "etsy-listings",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/templates": {
      "get": {
        "operationId": "list_templates_api_templates_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TemplateSummary"
                  },
                  "title": "Response List Templates Api Templates Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Templates",
        "tags": [
          "templates"
        ]
      },
      "post": {
        "operationId": "upload_template_api_templates_post",
        "parameters": [
          {
            "in": "query",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "required": true,
            "schema": {
              "enum": [
                "colour-matrix",
                "multiple",
                "single"
              ],
              "title": "Kind",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_template_api_templates_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload Template",
        "tags": [
          "templates"
        ]
      }
    },
    "/api/templates/{name}/config": {
      "get": {
        "operationId": "get_config_api_templates__name__config_get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "discriminator": {
                    "mapping": {
                      "colour-matrix": "#/components/schemas/ColourMatrixTemplate",
                      "multiple": "#/components/schemas/MultipleTemplate",
                      "single": "#/components/schemas/SingleTemplate"
                    },
                    "propertyName": "kind"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ColourMatrixTemplate"
                    },
                    {
                      "$ref": "#/components/schemas/MultipleTemplate"
                    },
                    {
                      "$ref": "#/components/schemas/SingleTemplate"
                    }
                  ],
                  "title": "Response Get Config Api Templates  Name  Config Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Config",
        "tags": [
          "templates"
        ]
      },
      "put": {
        "operationId": "put_config_api_templates__name__config_put",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ColourMatrixTemplate"
                  },
                  {
                    "$ref": "#/components/schemas/MultipleTemplate"
                  },
                  {
                    "$ref": "#/components/schemas/SingleTemplate"
                  }
                ],
                "title": "Body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "discriminator": {
                    "mapping": {
                      "colour-matrix": "#/components/schemas/ColourMatrixTemplate",
                      "multiple": "#/components/schemas/MultipleTemplate",
                      "single": "#/components/schemas/SingleTemplate"
                    },
                    "propertyName": "kind"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ColourMatrixTemplate"
                    },
                    {
                      "$ref": "#/components/schemas/MultipleTemplate"
                    },
                    {
                      "$ref": "#/components/schemas/SingleTemplate"
                    }
                  ],
                  "title": "Response Put Config Api Templates  Name  Config Put"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Put Config",
        "tags": [
          "templates"
        ]
      }
    },
    "/api/templates/{name}/preview": {
      "post": {
        "operationId": "preview_api_templates__name__preview_post",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ColourMatrixPreviewRequest"
                  },
                  {
                    "$ref": "#/components/schemas/MultiplePreviewRequest"
                  },
                  {
                    "$ref": "#/components/schemas/SinglePreviewRequest"
                  }
                ],
                "title": "Body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Preview",
        "tags": [
          "templates"
        ]
      }
    },
    "/{full_path}": {
      "get": {
        "operationId": "spa_fallback__full_path__get",
        "parameters": [
          {
            "in": "path",
            "name": "full_path",
            "required": true,
            "schema": {
              "title": "Full Path",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Spa Fallback"
      }
    }
  }
}
