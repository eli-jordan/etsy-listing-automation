{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" -S \"$CLAUDE_PROJECT_DIR/scripts/agent_lint_gate.py\" session-start; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" -S \"$CLAUDE_PROJECT_DIR/scripts/agent_lint_gate.py\" edit; exit $LASTEXITCODE",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" -S \"$CLAUDE_PROJECT_DIR/scripts/agent_lint_gate.py\" session-end; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
