.claude/settings.local.json

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/
.playwright-mcp/

# Node / frontend
node_modules/
src/etsy_listings/ui/frontend/dist/

# Workspace-local secrets (never present in this repo, guarded anyway)
.env
.auth/

# Browser-test screenshots. Artifacts for human review against the wireframes,
# not goldens -- nothing compares them, and a browser screenshot varies with
# the platform's font rasterisation, so committing them would only produce
# diffs nobody can act on.
tests/browser/_screenshots/

# Derived render caches (luminance/displacement maps). Fully derivable from
# the template photos, and regenerated on demand -- including under the test
# fixtures, where a run leaves several MB of .npy behind.
_derived/
